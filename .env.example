# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL/PostGIS connection (update port/user/password for your install)
DATABASE_URL=postgresql://username:password@localhost:5432/fuel_route_optimizer

# Routing / geocoding external services
OSRM_BASE_URL=https://router.project-osrm.org
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim usage policy requires identifying your application.
GEOCODER_USER_AGENT=fuel-route-optimizer/1.0 (local demo)

# Fuel model (fixed assumptions)
ROUTE_CORRIDOR_MILES=10
FUEL_MPG=10
MAX_RANGE_MILES=500
TANK_CAPACITY_GALLONS=50
STARTING_FUEL_GALLONS=50

# Caching / timeouts
CACHE_TTL_SECONDS=86400
ROUTING_CLIENT_TIMEOUT_SECONDS=15
GEOCODING_TIMEOUT_SECONDS=10

# GeoDjango: only needed if GDAL/GEOS DLLs are not auto-discovered on Windows.
# GDAL_LIBRARY_PATH=C:\Program Files\PostgreSQL\16\bin\libgdal-35.dll
# GEOS_LIBRARY_PATH=C:\Program Files\PostgreSQL\16\bin\libgeos_c.dll